# CENHUA Web 服务 systemd 单元（M5-1）
# 安装：sudo cp deploy/cenhua-web.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now cenhua-web
# 环境变量在 /etc/cenhua/cenhua.env 中配置（凭证不落盘到单元文件）。
[Unit]
Description=CENHUA personal second-brain Web UI + LAN API
After=network.target

[Service]
Type=simple
# 凭证/网关从 env 文件读取（chmod 600）
EnvironmentFile=-/etc/cenhua/cenhua.env
ExecStart=/usr/bin/env bash /opt/cenhua/deploy/service.sh start
ExecStop=/usr/bin/env bash /opt/cenhua/deploy/service.sh stop
Restart=always
RestartSec=5
# 启动保护期：服务自检 /health 就绪
TimeoutStartSec=30
# 安全加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
